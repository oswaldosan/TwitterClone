# -----------------------------------------------------------------------------
# Writter — copia este archivo a .env y ajusta valores locales.
# En Docker, compose inyecta DB_* y VITE_*; las variables de entorno del
# contenedor tienen prioridad sobre el archivo .env (Laravel no las pisa).
# -----------------------------------------------------------------------------

APP_NAME=Writter
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Laravel Debugbar (dev dependency). Omit or set true with APP_DEBUG; use false to hide the bar without turning off APP_DEBUG.
# DEBUGBAR_ENABLED=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL — use these values when the app runs inside Docker Compose (recommended).
# If you run `php artisan` on the host against the published port, use DB_HOST=127.0.0.1 and DB_PORT=3307.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=writter
DB_USERNAME=writter
DB_PASSWORD=writter_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# URL del servidor Vite en desarrollo (navegador en el host). En Docker: http://localhost:5173
VITE_DEV_SERVER_URL=http://localhost:5173

# Klipy (stickers) — https://docs.klipy.com/stickers-api/stickers-search-api
KLIPY_API_KEY=
# KLIPY_BASE_URL=https://api.klipy.com/api/v1

